<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.huzz.jaksho.domain.mapper.BizDomainMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="top.huzz.jaksho.domain.entity.BizDomain">
        <id column="id" property="id" />
        <result column="name" property="name"  />
        <result column="description" property="description"  />
        <result column="create_time" property="createTime"  />
        <result column="update_time" property="updateTime"  />
        <result column="workspace_id" property="workspaceId"  />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, description, create_time, update_time, workspace_id
    </sql>

    <!-- 分页查询业务领域 -->
    <select id="pageQuery" resultMap="BaseResultMap">
        SELECT
            <include refid="Base_Column_List"/>
        FROM sr_biz_domain bd
        WHERE bd.workspace_id = #{p.workspaceId}
        <!-- 如果传入了 bizFieldId，则排除已分配给该字段的领域 -->
        <if test="p.bizFieldId != null">
            AND NOT EXISTS (
                SELECT 1
                FROM sr_biz_field_domain bfd
                WHERE bfd.biz_domain_id = bd.id
                  AND bfd.biz_field_id = #{p.bizFieldId}
                  AND bfd.workspace_id = #{p.workspaceId}
            )
        </if>
        ORDER BY bd.update_time DESC
    </select>

</mapper>
