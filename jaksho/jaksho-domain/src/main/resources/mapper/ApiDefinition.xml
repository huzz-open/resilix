<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="top.huzz.jaksho.domain.mapper.ApiDefinitionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="top.huzz.jaksho.domain.entity.ApiDefinition">
        <id column="id" property="id" />
        <result column="name" property="name"  />
        <result column="method" property="method" typeHandler="top.huzz.jaksho.common.json.CustomFastjson2TypeHandler" />
        <result column="path" property="path"  />
        <result column="description" property="description"  />
        <result column="body_type" property="bodyType" typeHandler="top.huzz.jaksho.common.json.CustomFastjson2TypeHandler" />
        <result column="workspace_id" property="workspaceId"  />
        <result column="create_time" property="createTime"  />
        <result column="update_time" property="updateTime"  />
        <result column="remark" property="remark"  />
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        id, name, method, path, description, body_type, workspace_id, create_time, update_time, remark
    </sql>

</mapper>
